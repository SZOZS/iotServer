# 定义C++编译器（使用g++）
CXX = g++

# 定义最终生成的可执行文件名称
TARGET = iotPoolServer

# 递归查找当前目录及所有子目录中的.cpp源文件
# $(shell ...)用于执行shell命令，find . -name "*.cpp"会列出所有.cpp文件
SRCS = $(shell find . -name "*.cpp")

# 将源文件路径转换为目标文件路径：
# 例如./src/main.cpp -> .obj/src/main.o
# patsubst是Makefile的模式替换函数，用于保持目录结构一致
OBJS = $(patsubst %.cpp, .obj/%.o, $(SRCS))

# 定义依赖文件路径：将所有.o文件替换为.d文件
# .d文件用于记录头文件依赖关系（如a.cpp依赖b.h，则a.d中会记录该关系）
DEPS = $(OBJS:.o=.d)

# 头文件包含路径：指定编译器查找头文件的目录
# # 这里包含了Boost库和MySQL客户端的头文件路径
INCLUDES = -I/opt/homebrew/opt/boost@1.85/include \
           -I/opt/homebrew/opt/mysql-client/include \
           -I/opt/homebrew/opt/hiredis/include \
           -I/opt/homebrew/opt/openssl@3/include

# C++编译选项：
# $(INCLUDES)：引入上面定义的头文件路径
# -Wall：开启所有警告信息
# -Wextra：开启额外警告（比-Wall更严格）
# -Wno-deprecated-copy-with-user-provided-copy：屏蔽特定的Boost库拷贝警告
CXXFLAGS = $(INCLUDES) -Wall -Wextra -Wno-deprecated-copy-with-user-provided-copy

# 链接器选项：指定链接器查找库文件的目录
# 这里指定了Boost库和MySQL客户端的库路径
LDFLAGS = -L/opt/homebrew/opt/boost@1.85/lib \
          -L/opt/homebrew/opt/mysql-client/lib \
          -L/opt/homebrew/opt/hiredis/lib \
          -L/opt/homebrew/opt/openssl@3/lib
# INCLUDES = 
# LDFLAGS = 

# 链接时需要的库：
# -lboost_system：Boost系统库（用于异步IO等功能）
# -pthread：启用多线程支持
# -lmysqlclient：MySQL客户端库（用于数据库操作）
LDLIBS = -lboost_system -lmysqlclient -lhiredis -liconv -lcrypto -pthread

# 定义伪目标：防止目录中存在与目标同名的文件时，Make误判
# .PHONY后面的目标不会被视为文件，总是会执行其规则
.PHONY: all clean

# 默认目标：执行make时若不指定目标，默认执行all
# all依赖于$(TARGET)，即先编译出可执行文件才算完成
all:
	@echo "================================================================================================================================================================"
	@echo "[构建启动] 开始编译项目: $(TARGET)"
	@echo "================================================================================================================================================================"
	$(MAKE) $(TARGET)
	@if [ -f "$(TARGET)" ]; then \
	  echo "================================================================================================================================================================"; \
	  echo "[构建完成] 可执行文件已生成: $(shell pwd)/$(TARGET)"; \
	  SIZE=$$(du -h "$(TARGET)" | cut -f1 2>/dev/null); \
	  echo "[文件大小] $$SIZE"; \
	  echo "================================================================================================================================================================"; \
	else \
	  echo "================================================================================================================================================================"; \
	  echo "[构建失败] 可执行文件未生成"; \
	  echo "================================================================================================================================================================"; \
	fi

# 链接规则：将所有目标文件(.o)链接为可执行文件
# $@表示当前目标（即$(TARGET)）
# $(OBJS)是所有依赖的目标文件
# 链接命令：编译器将目标文件与指定的库链接，生成可执行文件
$(TARGET): $(OBJS)
	@echo "[链接阶段] 正在生成可执行文件..."
	$(CXX) $(OBJS) -o $@ $(LDFLAGS) $(LDLIBS)
	@echo "[链接成功] 可执行文件: $@"

# 编译规则：将.cpp源文件编译为.obj目录下的.o目标文件
# $<表示第一个依赖文件（即当前的.cpp文件）
# $@表示当前目标（即对应的.o文件）
# -c：只编译不链接，生成目标文件
# -MMD：自动生成依赖文件（.d），记录该.cpp依赖的所有头文件
# -MP：为每个依赖的头文件创建一个空目标，避免头文件被删除后Make报错
# @mkdir -p $(dir $@)：自动创建目标文件所在的目录（若不存在）
.obj/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo "[编译] 处理文件: $<"
	$(CXX) $(CXXFLAGS) -c $< -o $@ -MMD -MP
	@if [ -f "$@" ]; then \
	  SIZE=$$(du -h "$@" | cut -f1 2>/dev/null || stat -f"%z" "$@" 2>/dev/null); \
	  echo "[编译成功] 生成目标: $(notdir $@) (大小: $$SIZE)"; \
	else \
	  echo "[编译失败] 未能生成 $(notdir $@)"; \
	fi


# 引入所有依赖文件（.d）：
# 当头文件被修改时，Make会根据.d文件自动重新编译相关的.cpp文件
# -include表示忽略不存在的.d文件（首次编译时可能还未生成）
-include $(DEPS)

# 清理规则：删除编译生成的所有产物
# rm -rf：强制删除目录及文件
# $(TARGET)：可执行文件
# .obj/：存放目标文件和依赖文件的目录
clean:
	@echo "================================================================================================================================================================"
	@echo "[清理启动] 开始移除编译产物..."
	rm -rf $(TARGET) .obj/
	@echo "[清理完成] 所有临时文件已删除"
	@echo "================================================================================================================================================================\n"




